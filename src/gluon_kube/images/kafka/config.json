{
  "User": "appuser",
  "WorkingDir": null,
  "Entrypoint": [
    "/__cacert_entrypoint.sh"
  ],
  "Cmd": [
    "/etc/kafka/docker/run"
  ],
  "Env": [
    "PATH=/opt/java/openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "JAVA_HOME=/opt/java/openjdk",
    "LANG=en_US.UTF-8",
    "LANGUAGE=en_US:en",
    "LC_ALL=en_US.UTF-8",
    "JAVA_VERSION=jdk-21.0.4+7"
  ]
}
